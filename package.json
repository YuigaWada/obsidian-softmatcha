{
  "name": "softmatcha-for-obsidian",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "assets": "server/.venv/bin/python scripts/export-assets.py",
    "check": "npm run build && npm test",
    "format": "prettier --write \"src/**/*.ts\" \"tests/*.mjs\" build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.7",
    "obsidian": "^1.8.7",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "kuromoji": "^0.1.2"
  }
}
