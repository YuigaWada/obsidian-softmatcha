{
  "name": "softmatcha-for-obsidian",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "test": "node scripts/test.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "assets": "server/.venv/bin/python scripts/export-assets.py",
    "check": "npm run lint && npm run build && npm test && npm run validate:release",
    "format": "prettier --write \"src/**/*.ts\" \"tests/*.mjs\" build.mjs",
    "lint": "eslint src --max-warnings 0",
    "validate:release": "node scripts/validate-release.mjs --built",
    "version:bump": "node scripts/version.mjs",
    "package": "python3 scripts/package.py",
    "package:models": "python3 scripts/package.py --models",
    "assets:catalog": "python3 scripts/model-catalog.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fake-indexeddb": "^6.2.7",
    "obsidian": "^1.8.7",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "kuromoji": "^0.1.2"
  },
  "license": "MIT",
  "description": "Local English and Japanese semantic search for Obsidian.",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuigaWada/SoftMatcha-for-Obsidian.git"
  },
  "homepage": "https://github.com/YuigaWada/SoftMatcha-for-Obsidian",
  "bugs": {
    "url": "https://github.com/YuigaWada/SoftMatcha-for-Obsidian/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Yuiga Wada"
}
