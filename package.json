{
  "name": "softmatcha-for-obsidian",
  "version": "0.3.6",
  "private": true,
  "scripts": {
    "build": "tsc --project config/tsconfig.json --noEmit && node scripts/build/plugin.mjs",
    "test": "node scripts/test/plugin.mjs",
    "build:wasm": "bash scripts/build/wasm.sh",
    "assets": ".local/venv/bin/python scripts/models/export.py",
    "check": "npm run lint && npm run build && npm test && npm run validate:release",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"benchmarks/*.mjs\" \"config/**/*.mjs\"",
    "lint": "eslint --config config/eslint.config.mjs src --max-warnings 0",
    "validate:release": "node scripts/release/validate.mjs --built",
    "version:bump": "node scripts/release/version.mjs",
    "package": "python3 scripts/release/package.py",
    "package:models": "python3 scripts/release/package.py --models",
    "assets:catalog": "python3 scripts/models/catalog.py",
    "test:rust": "cargo test --locked --manifest-path src/rust/Cargo.toml --target-dir build/rust -p softmatcha-core",
    "test:ios": "node scripts/test/ios.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fake-indexeddb": "^6.2.7",
    "obsidian": "^1.8.7",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "fflate": "^0.8.3",
    "kuromoji": "^0.1.2"
  },
  "license": "MIT",
  "description": "Local English and Japanese semantic search for Obsidian.",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuigaWada/SoftMatcha-for-Obsidian.git"
  },
  "homepage": "https://github.com/YuigaWada/SoftMatcha-for-Obsidian",
  "bugs": {
    "url": "https://github.com/YuigaWada/SoftMatcha-for-Obsidian/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Yuiga Wada"
}
